{
    "name": "DS_Landing_Estimates",
    "properties": {
        "description": "The vendor's data file: landing/<folder>/repair_estimates.csv. Header row, so rowsCopied counts data rows only.",
        "linkedServiceName": {
            "referenceName": "LS_ADLS_Polaris",
            "type": "LinkedServiceReference"
        },
        "parameters": {
            "folder": { "type": "string" }
        },
        "type": "DelimitedText",
        "typeProperties": {
            "location": {
                "type": "AzureBlobFSLocation",
                "fileSystem": "landing",
                "folderPath": { "value": "@dataset().folder", "type": "Expression" },
                "fileName": "repair_estimates.csv"
            },
            "columnDelimiter": ",",
            "escapeChar": "\\",
            "quoteChar": "\"",
            "firstRowAsHeader": true
        },
        "schema": []
    }
}
